+func TestHizliCozucuKayitAyni(t *testing.T) {
+	r := rand.New(rand.NewSource(7))
+	for _, bicim := range hizliTestBicimleri {
+		hizli := compileFormat("test", bicim)
+		yavas := compileFormat("test", bicim)
