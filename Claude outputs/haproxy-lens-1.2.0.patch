+// Biçime hiç uymayan uzun satırlarda (başka bir programın satırı) deneme sayısı patlamamalı
+func TestHizliCozucuUyumsuzSatirdaYavaslamaz(t *testing.T) {
+	cf := compileFormat("httplog", fmtHTTPLog)
