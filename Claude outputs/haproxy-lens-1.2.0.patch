+	bas := time.Now()
+	for i := 0; i < 200; i++ {
+		cf.parse(satir, nil)
+	}
+	if gecen := time.Since(bas); gecen > 2*time.Second {
+		t.Fatalf("uyumsuz satır çok yavaş: 200 satır %v", gecen)
+	}
+}
